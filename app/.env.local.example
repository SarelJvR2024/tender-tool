# Copy this to .env.local (gitignored) and fill in your real Supabase project values -
# Settings > API in the Supabase dashboard. Never commit the real file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server-side only, NEVER prefixed with NEXT_PUBLIC_, NEVER sent to
# the browser. Used only by engine/seed_supabase_*.py to write the shared `tenders`
# table and seed company data - the Next.js app itself never needs it, since every
# client-facing write goes through RLS with the anon key + a real user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google/Microsoft OAuth are configured in the Supabase dashboard (Authentication >
# Providers), not here - this app only calls supabase.auth.signInWithOAuth(), it never
# holds the provider client secrets itself.

# PayFast (subscription billing, app/lib/payfast.ts). Server-side only - never
# NEXT_PUBLIC_. Leave PAYFAST_MODE unset (or "sandbox") to test against PayFast's
# sandbox - it has its own public test merchant credentials, so this works even
# before a real PayFast account is wired in. Set PAYFAST_MODE=live and the real
# Merchant ID/Key/Passphrase (from the PayFast merchant dashboard) only when
# ready to take real payments.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
